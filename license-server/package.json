{
  "name": "apna-billing-license-server",
  "version": "1.0.0",
  "private": true,
  "description": "Central license management API and Admin Panel host for Apna Billing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "keys:generate": "tsx src/scripts/generateKeys.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
