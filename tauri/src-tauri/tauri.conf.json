{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apna Billing",
  "version": "1.2.0",
  "identifier": "in.apnabilling.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "copyright": "Copyright (c) 2026 Apna Billing",
    "category": "Business",
    "shortDescription": "Billing, inventory and accounts for your business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine": "engine"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRTgyRUY3N0E2OUVDQUUKUldTdTdHbDY5eTdvUG4rcXhWYmRLaUU3amh6ak1Tcnp1S2tmWTNQbS9NOHhGUE5UdTFlOWJOTngK",
      "endpoints": [
        "https://127.0.0.1/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
